/*
    Settings for the TIMEPOINT_DMR workflow (timepoint_dmr.nf). The DMR settings in conf/modules.config select
    '.*:DMR:...' and so do not apply to a workflow with another name.
*/

process {
    // conf/modules.config publishes every process into <outdir>/<first word of its name>; only the DMR results
    // are wanted, and the checked and indexed pileups are copies of very large inputs
    withName: '.*TIMEPOINT_DMR:(DMR_CHECK_MODIFICATIONS|DMR_HAPLOTYPE_REGIONS)' {
        publishDir = [ enabled: false ]
    }
    withName: 'TIMEPOINT_FAIDX' {
        publishDir = [ enabled: false ]
    }
    withName: '.*TIMEPOINT_DMR:HTSLIB_BGZIPTABIX' {
        ext.args2 = '-p bed'
        publishDir = [ enabled: false ]
    }
    withName: '.*TIMEPOINT_DMR:MODKIT_DMR' {
        ext.args   = '--base C'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/dmr" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.log') ? filename : null }
        ]
    }
    withName: '.*TIMEPOINT_DMR:DMR_NEAREST_GENE' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/dmr" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
