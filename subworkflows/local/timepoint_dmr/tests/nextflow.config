// conf/timepoint_dmr.config (included by the root nextflow.config) supplies the TIMEPOINT_DMR settings;
// only the setup pileup needs its arguments here. 5hmC is requested as lrsomatic does when DMR will run.
process {
    withName: 'MODKIT_PILEUP' {
        ext.args = '--modified-bases 5mC 5hmC'
    }
}
